# deploy/collector/.env on the VPS (never committed)
COLLECTOR_DB_PASSWORD=generated-on-the-vps
MIP_SYNC_PASSWORD=generated-on-the-vps        # also goes into the Mac's MIP_COLLECTOR_DSN
MIP_HASH_SALT=SAME-VALUE-AS-ON-THE-MAC          # identities are salted hashes: must match, or joins break
# YouTube (read-only use): an API key, or the OAuth trio (same values as the Mac's .env)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
