# Copy to /srv/apps/mip-weekly/weekly.env on the server (never commit it). Non-secret settings only.
GIT_COMMIT=0000000            # git rev-parse --short HEAD of the checkout the image is built from; also the image tag
MIP_DB_NETWORK=               # docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <mip-postgres container>
MIP_PG_HOST=                  # mip-postgres container / service name on that network
MIP_COLLECTOR_SSH=            # user@<VPS tailscale ip>, same value as MIP_COLLECTOR_SSH in the Mac's .env
#MIP_WEEKLY_DATA=/srv/data/mip-weekly
#MIP_WEEKLY_METRICS=/srv/data/mip-weekly/metrics
MIP_WEEKLY_SECRETS=/srv/apps/mip-weekly/secrets
MIP_WEEKLY_KNOWN_HOSTS=/srv/apps/mip-weekly/known_hosts
