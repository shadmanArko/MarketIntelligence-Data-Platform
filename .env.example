# Postgres (docker-compose maps to localhost:5434)
MIP_DATABASE_URL=postgresql://mip:mip@localhost:5434/mip
MIP_DATA_DIR=./data
# Commenter / reviewer identity hashing salt — set once, never change
MIP_HASH_SALT=change-me
# Meta Graph API (Instagram Business Discovery)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Google (optional: Places API free tier)
GOOGLE_PLACES_API_KEY=
# Hugging Face (Foursquare OS Places is gated)
HF_TOKEN=
# TikTokApi
TIKTOK_MS_TOKEN=
# Paid fallbacks (disabled until budget)
APIFY_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
